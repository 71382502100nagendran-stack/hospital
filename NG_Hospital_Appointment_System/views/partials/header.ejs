<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'NG Hospitals Appointment System' %></title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏥</text></svg>">
    <link rel="stylesheet" href="/static/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Top Navigation Bar -->
    <header class="navbar">
        <div class="nav-container">
            <a href="/" class="logo">
                <span class="logo-icon">🏥</span>
                <span class="logo-text">NG <strong>Hospitals</strong></span>
            </a>
            <nav class="nav-links">
                <a href="/" class="nav-link <%= currentPath === '/' ? 'active' : '' %>">Book Appointment</a>
                <a href="/appointments" class="nav-link <%= currentPath === '/appointments' ? 'active' : '' %>">Appointments</a>
                <a href="/doctors" class="nav-link <%= currentPath === '/doctors' ? 'active' : '' %>">Our Doctors</a>
            </nav>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="main-container">
        <!-- Flash Alert Messages -->
        <% if (flash) { %>
            <div class="flash-messages">
                <div class="alert alert-<%= flash.type %>">
                    <span class="alert-icon"><%= flash.type === 'success' ? '✓' : '⚠' %></span>
                    <span class="alert-text"><%= flash.message %></span>
                </div>
            </div>
        <% } %>
